## Vehicle Switching Pattern
```qml
// Always store current vehicle before switching
var currentVehicle = QGroundControl.multiVehicleManager.activeVehicle;

// Switch to target vehicle
if (targetVehicle && targetVehicle !== currentVehicle) {
    QGroundControl.multiVehicleManager.activeVehicle = targetVehicle;
}

// Perform operation
// ... mission item operations ...

// Always switch back
if (targetVehicle && targetVehicle !== currentVehicle) {
    QGroundControl.multiVehicleManager.activeVehicle = currentVehicle;
}
```

## Mission Controller Integration
```qml
// Access mission controller
property var planMasterController

// Insert mission items
planMasterController.missionController.insertTakeoffItem(coordinate, index, true);
planMasterController.missionController.insertSimpleMissionItem(coordinate, index, true);
planMasterController.missionController.insertLandItem(coordinate, index, true);

// Get current index
var nextIndex = planMasterController.missionController.currentPlanViewVIIndex + 1;
```

