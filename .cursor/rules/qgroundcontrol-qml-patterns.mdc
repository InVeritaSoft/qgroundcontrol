# QGroundControl QML Patterns

## Mission Item Management
```qml
// Function to add takeoff item using QML mission controller
function addTakeoffItem(coordinate, altitude, targetVehicle) {
    console.log("GenCall60: Adding takeoff item at", coordinate.toString(), "altitude", altitude, "to vehicle", targetVehicle ? targetVehicle.id : "unknown");
    
    // Store current active vehicle
    var currentVehicle = QGroundControl.multiVehicleManager.activeVehicle;
    
    // Switch to target vehicle if different
    if (targetVehicle && targetVehicle !== currentVehicle) {
        QGroundControl.multiVehicleManager.activeVehicle = targetVehicle;
    }
    
    // Always start at index 1 for takeoff
    var nextIndex = 1;
    planMasterController.missionController.insertTakeoffItem(coordinate, nextIndex, true);
    
    // Switch back to original vehicle
    if (targetVehicle && targetVehicle !== currentVehicle) {
        QGroundControl.multiVehicleManager.activeVehicle = currentVehicle;
    }
}
```

## Signal Connections
```qml
Connections {
    target: QGroundControl.missionService
    function onAddTakeoffItemRequested(coordinate, altitude, targetVehicle) {
        addTakeoffItem(coordinate, altitude, targetVehicle);
    }
    function onAddWaypointItemRequested(coordinate, altitude, targetVehicle) {
        addWaypointItem(coordinate, altitude, targetVehicle);
    }
    function onAddLandItemRequested(coordinate, targetVehicle) {
        addLandItem(coordinate, targetVehicle);
    }
}
```

