```cpp
// Test coordinate calculations
void PtahMissionGeneratorTest::testCalculateNewCoordinates()
{
    QGeoCoordinate reference(37.7749, -122.4194, 100.0);
    double bearing = 90.0; // East
    double distance = 100.0; // 100 meters
    
    QGeoCoordinate result = generator->calculateNewCoordinates(reference, bearing, distance);
    
    QVERIFY(result.isValid());
    QVERIFY(qAbs(result.latitude() - reference.latitude()) < 0.001);
    QVERIFY(result.longitude() > reference.longitude());
