# QGroundControl Coordinate Calculation System

## Core Coordinate Operations

### New Coordinate Calculation
```cpp
// In PtahMissionGenerator::calculateNewCoordinates()
QGeoCoordinate PtahMissionGenerator::calculateNewCoordinates(
    const QGeoCoordinate& reference, 
    double bearing, 
    double distanceMeters)
{
    const double earthRadius = 6371000.0; // Earth radius in meters
    
    // Convert bearing to radians
    double bearingRad = qDegreesToRadians(bearing);
    
    // Convert reference coordinates to radians
    double lat1Rad = qDegreesToRadians(reference.latitude());
    double lng1Rad = qDegreesToRadians(reference.longitude());
    
    // Calculate new latitude
    double lat2Rad = asin(sin(lat1Rad) * cos(distanceMeters / earthRadius) + 
                         cos(lat1Rad) * sin(distanceMeters / earthRadius) * cos(bearingRad));
    
    // Calculate new longitude
    double lng2Rad = lng1Rad + atan2(sin(bearingRad) * sin(distanceMeters / earthRadius) * cos(lat1Rad),
                                     cos(distanceMeters / earthRadius) - sin(lat1Rad) * sin(lat2Rad));
    
    // Convert back to degrees
    double lat2Deg = qRadiansToDegrees(lat2Rad);
    double lng2Deg = qRadiansToDegrees(lng2Rad);
    
    return QGeoCoordinate(lat2Deg, lng2Deg, reference.altitude());
}
```

### Bearing Calculation
```cpp
// In PtahMissionGenerator::calculateBearing()
double PtahMissionGenerator::calculateBearing(const QGeoCoordinate& from, const QGeoCoordinate& to)
{
    if (!from.isValid() || !to.isValid()) {
        return 0.0;
    }
    
    return from.azimuthTo(to);
}
```

### Middle Point Calculation
```cpp
// In PtahMissionGenerator::calculateMiddlePoint()
QGeoCoordinate PtahMissionGenerator::calculateMiddlePoint(const QList<QGeoCoordinate>& coordinates)
{
    if (coordinates.isEmpty()) {
        return QGeoCoordinate();
    }
    
    double totalLat = 0.0;
    double totalLng = 0.0;
    double totalAlt = 0.0;
    
    for (const QGeoCoordinate& coord : coordinates) {
        totalLat += coord.latitude();
        totalLng += coord.longitude();
        totalAlt += coord.altitude();
    }
    
    double avgLat = totalLat / coordinates.size();
    double avgLng = totalLng / coordinates.size();
    double avgAlt = totalAlt / coordinates.size();
    
    return QGeoCoordinate(avgLat, avgLng, avgAlt);
}
```

## Waypoint Generation Patterns

### Sequential Waypoint Generation
```cpp
// In PtahMissionGenerator::generateCoordinatesInBothDirections()
QList<QGeoCoordinate> PtahMissionGenerator::generateCoordinatesInBothDirections(
    const QGeoCoordinate& reference, 
    double bearing, 
    double gapMeters, 
    double totalDistanceMeters)
{
    QList<QGeoCoordinate> coordinates;
    
    if (!reference.isValid() || gapMeters <= 0 || totalDistanceMeters <= 0) {
        return coordinates;
    }
    
    // Calculate number of points to generate
    int pointsInEachDirection = static_cast<int>(totalDistanceMeters / gapMeters);
    
    // Add reference point as waypoint 1
    coordinates.append(reference);
    
    // Generate waypoints in sequence: 1,2,3,4,5,6,7...
    for (int i = 1; i <= pointsInEachDirection; i++) {
        double distance = i * gapMeters;
        QGeoCoordinate waypoint = calculateNewCoordinates(reference, bearing, distance);
        if (waypoint.isValid()) {
            coordinates.append(waypoint);
        }
    }
    
    return coordinates;
}
```

