## Safe Position Calculations

### Mission Area Bounds Calculation
```cpp
// Calculate mission area bounds for safe positioning
void calculateMissionBounds(const QList<QGeoCoordinate>& waypoints, 
                           double& minLat, double& maxLat, 
                           double& minLng, double& maxLng)
{
    if (waypoints.isEmpty()) return;
    
    minLat = maxLat = waypoints[0].latitude();
    minLng = maxLng = waypoints[0].longitude();
    
    for (const QGeoCoordinate& coord : waypoints) {
        minLat = qMin(minLat, coord.latitude());
        maxLat = qMax(maxLat, coord.latitude());
        minLng = qMin(minLng, coord.longitude());
        maxLng = qMax(maxLng, coord.longitude());
    }
}
```

### Safe Observation Position
```cpp
// In PtahMissionGenerator::calculateSafeObservationPosition()
QGeoCoordinate PtahMissionGenerator::calculateSafeObservationPosition(
    const QGeoCoordinate& missionCenter, 
    const QList<QGeoCoordinate>& waypoints, 
    int altitude)
{
    if (waypoints.isEmpty()) {
        return missionCenter;
    }
    
    // Calculate mission area bounds
    double minLat, maxLat, minLng, maxLng;
    calculateMissionBounds(waypoints, minLat, maxLat, minLng, maxLng);
    
    // Calculate mission area span
    double latSpan = maxLat - minLat;
    double lngSpan = maxLng - minLng;
    
    // Determine mission orientation
    bool isEastWestOriented = lngSpan > latSpan;
    
    // Calculate safe distance (50% safety margin)
    double safeDistance = qMax(latSpan, lngSpan) * 1.5;
    
    // Position observer outside mission area
    QGeoCoordinate safePosition = missionCenter;
    if (isEastWestOriented) {
        // Mission is east-west oriented, position observer SOUTH
        safePosition.setLatitude(missionCenter.latitude() - safeDistance);
    } else {
        // Mission is north-south oriented, position observer WEST
        safePosition.setLongitude(missionCenter.longitude() - safeDistance);
    }
    
    safePosition.setAltitude(altitude);
    
    return safePosition;
}
```

## Coordinate Validation Patterns

### Always Validate Coordinates
```cpp
// Check coordinate validity before operations
if (!coordinate.isValid()) {
    qCWarning(MissionServiceLog) << "Invalid coordinate provided";
    return QGeoCoordinate();
}

// Check for valid latitude/longitude ranges
if (coordinate.latitude() < -90.0 || coordinate.latitude() > 90.0) {
    qCWarning(MissionServiceLog) << "Invalid latitude:" << coordinate.latitude();
    return QGeoCoordinate();
}

if (coordinate.longitude() < -180.0 || coordinate.longitude() > 180.0) {
    qCWarning(MissionServiceLog) << "Invalid longitude:" << coordinate.longitude();
    return QGeoCoordinate();
}
```

