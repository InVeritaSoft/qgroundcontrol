# ArduPilot Copter SITL Demo Configuration
# This file contains optimized parameters for QGroundControl demonstrations

# Vehicle Configuration
FRAME_CLASS 1
FRAME_TYPE 0
MOT_PWM_TYPE 1
MOT_PWM_RATE 490
SERVO_PWM_TYPE 1
SERVO_PWM_RATE 50

# Flight Modes
FLTMODE1 3
FLTMODE2 4
FLTMODE3 6
FLTMODE4 0
FLTMODE5 0
FLTMODE6 0

# GPS Configuration
GPS_TYPE 1
GPS_AUTO_CONFIG 1
GPS_AUTO_SWITCH 1
GPS_HDOP_GOOD 200
GPS_HDOP_FILT 200

# Simulation Parameters
SIM_GPS_ENABLE 1
SIM_GPS_DISABLE 0
SIM_GPS_LAT 47.397742
SIM_GPS_LON 8.545594
SIM_GPS_ALT 488
SIM_GPS_HDOP 1.0
SIM_GPS_VDOP 1.5
SIM_GPS_NUMSATS 10
SIM_GPS_SPEED 0
SIM_GPS_DELAY 1

# RC Input Simulation
SIM_RC_ENABLE 1
SIM_RC_CH1 1500
SIM_RC_CH2 1500
SIM_RC_CH3 1100
SIM_RC_CH4 1500
SIM_RC_CH5 1500
SIM_RC_CH6 1500
SIM_RC_CH7 1500
SIM_RC_CH8 1500

# Performance Tuning
SIM_SPEEDUP 1
SIM_DRIFT_SPEED 0
SIM_DRIFT_TIME 0
SIM_WIND_SPD 0
SIM_WIND_DIR 0
SIM_WIND_TURB 0

# Safety Features
FENCE_ENABLE 1
FENCE_TYPE 1
FENCE_ACTION 0
FENCE_ALT_MAX 100
FENCE_RADIUS 100

# Mission Parameters
MIS_TOTAL 0
MIS_RESTART 0
MIS_INDEX 0

# Logging
LOG_BITMASK 830
LOG_DISARMED 0
LOG_FILE_DSRMROT 0

# Advanced Features
EK3_ENABLE 1
EK3_GPS_TYPE 0
EK3_GPS_POS_X 0
EK3_GPS_POS_Y 0
EK3_GPS_POS_Z 0

# Camera Control (if available)
CAM_DURATION 10
CAM_TRIGG_DIST 25
CAM_SERVO_ON 0
CAM_SERVO_OFF 0

# Geofence
FENCE_ALT_MAX 100
FENCE_RADIUS 100
FENCE_MARGIN 2

# Return to Launch
RTL_ALT 50
RTL_ALT_FINAL 0
RTL_SPEED 0
RTL_LOIT_TIME 5000

# Auto Landing
LAND_SPEED 0
LAND_ALT_LOW 10
LAND_ALT_HIGH 50 